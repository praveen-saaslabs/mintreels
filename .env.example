NODE_ENV=development

# Database (MySQL 8)
DATABASE_URL=mysql://mintreels:mintreels@127.0.0.1:3306/mintreels
MYSQL_ROOT_PASSWORD=mintreels
MYSQL_USER=mintreels
MYSQL_PASSWORD=mintreels
MYSQL_DATABASE=mintreels

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PyAI
PYAI_API_KEY=
PYAI_BASE_URL=

# Provider configuration
AI_PROVIDER=pyai
KNOWLEDGE_BASE_PROVIDER=pyai
STORAGE_PROVIDER=s3
QUEUE_PROVIDER=bullmq

# Web (Vite)
VITE_API_TARGET=
# Auth (API only — never put JWT/SMTP secrets in frontend env)
JWT_SECRET=
JWT_EXPIRES_IN=24h
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
WEB_ORIGIN=http://127.0.0.1:5173
