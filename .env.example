# ============================================================================
# MintReels Environment Configuration
# ============================================================================
# This file serves as a template for all environment variables used in the
# MintReels application. Copy this to .env and fill in your actual values.
#
# SECURITY NOTE: Never commit .env files with real secrets to version control!
# ============================================================================

# ============================================================================
# CORE APPLICATION SETTINGS
# ============================================================================
# Basic runtime configuration for all services

NODE_ENV=development
# API server port (development default: 3000)
PORT=3000
# Nest API log verbosity: error | warn | log | debug | verbose (default: log)
LOG_LEVEL=

# ============================================================================
# DATABASE & CACHE
# ============================================================================
# Primary data storage and caching configuration

## MySQL Database (Primary Storage)
DATABASE_URL=mysql://mintreels:mintreels@127.0.0.1:3306/mintreels
MYSQL_ROOT_PASSWORD=mintreels
MYSQL_USER=mintreels
MYSQL_PASSWORD=mintreels
MYSQL_DATABASE=mintreels

## Redis Cache & Sessions
REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

## File Storage (Filestack)
# Server-side operations (worker store/delete). APP_SECRET required for file deletion.
FILESTACK_API_KEY=
FILESTACK_APP_SECRET=
# Browser upload only (frontend). Use same key as FILESTACK_API_KEY; never expose APP_SECRET here.
VITE_FILESTACK_API_KEY=

## AI/ML Services

### PyAI (Primary AI Provider)
# Speak (clip VO/overdub) needs voice:synthesize scope in addition to Hear scopes
AI_PROVIDER=pyai
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com

### OpenAI (LLM Provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

### NVIDIA (Alternative LLM Provider)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

## Email Services (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ============================================================================
# PROVIDER CONFIGURATION
# ============================================================================
# Service provider selection and routing

KNOWLEDGE_BASE_PROVIDER=pyai
STORAGE_PROVIDER=filestack
QUEUE_PROVIDER=bullmq

# ============================================================================
# JOB PROCESSING & WORKER CONFIGURATION
# ============================================================================
# Background job processing and worker behavior

WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=4
JOB_RETRY_BASE_DELAY_MS=5000
JOB_STEP_STALE_TIMEOUT_MS=1800000

# ============================================================================
# VECTOR SEARCH & EMBEDDINGS
# ============================================================================
# Configuration for semantic search and AI-powered content discovery

## Embedding Provider
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

## Vector Store (Qdrant)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hook_vectors
QDRANT_TRANSCRIPT_COLLECTION=transcript_windows

## Search Parameters
MOMENT_SEARCH_LIMIT=8
MOMENT_SEARCH_MIN_SIMILARITY=0.35
HOOK_SIMILARITY_THRESHOLD=0.85
HOOK_MAX_CANDIDATES=50
HOOK_FINAL_COUNT=10

## Clip Generation
CLIP_PREROLL_MS=3000
CLIP_POSTROLL_MS=5000

## Hook Scoring Weights
# These weights determine how different qualities are valued when scoring content hooks.
# All weights should sum to 1.0 for proper normalization.
HOOK_WEIGHT_QUALITY=0.22      # Overall content quality and production value
HOOK_WEIGHT_STANDALONE=0.15   # How well content works independently
HOOK_WEIGHT_CURIOSITY=0.12    # Ability to spark viewer interest
HOOK_WEIGHT_EMOTIONAL=0.08    # Emotional impact and resonance
HOOK_WEIGHT_SPECIFICITY=0.08  # Concrete, specific details vs. generic content
HOOK_WEIGHT_SHAREABILITY=0.08 # Likelihood of being shared on social media
HOOK_WEIGHT_NOVELTY=0.04      # Uniqueness and freshness of content
HOOK_WEIGHT_CONTROVERSY=0.12  # Ability to generate discussion/debate
HOOK_WEIGHT_HEADLINE=0.11     # Headline-worthy or attention-grabbing nature

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# User authentication and security configuration

JWT_SECRET=
JWT_EXPIRES_IN=24h
# Development only: skip email verification on login (set to true/1). Leave empty for production.
AUTH_SKIP_EMAIL_VERIFY=

# ============================================================================
# WEB & FRONTEND CONFIGURATION
# ============================================================================
# Frontend application and development server settings

## Vite Development Server
VITE_API_TARGET=
## Application Origin (CORS and auth callbacks)
WEB_ORIGIN=http://127.0.0.1:5173

# ============================================================================
# GUEST SYSTEM CONFIGURATION
# ============================================================================
# Anonymous user sandbox with rate limiting and resource constraints
# Set GUEST_ENABLED=false to disable the entire guest system

GUEST_ENABLED=true

## Session Management
GUEST_SESSION_TTL_SECONDS=86400        # 24 hours: how long guest sessions remain active
GUEST_DATA_RETENTION_SECONDS=259200    # 72 hours: how long guest data is kept before cleanup
GUEST_CLEANUP_INTERVAL_MS=3600000      # 1 hour: how often cleanup job runs

## Resource Limits (per guest session)
GUEST_MAX_PROJECTS=1                   # Maximum projects a guest can create
GUEST_MAX_RECORDINGS=3                 # Maximum recordings per guest project

## Rate Limiting (prevents abuse)
GUEST_REQUESTS_PER_MINUTE=100          # General API request limit
GUEST_UPLOADS_PER_HOUR=5               # File upload limit
GUEST_TRANSCRIPTIONS_PER_HOUR=3        # Transcription job limit
GUEST_AI_GENERATIONS_PER_HOUR=5        # AI processing job limit
GUEST_SESSION_CREATIONS_PER_IP_PER_HOUR=10  # New session creation limit per IP
