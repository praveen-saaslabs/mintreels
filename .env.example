NODE_ENV=development

# Database (MySQL 8)
DATABASE_URL=mysql://mintreels:mintreels@127.0.0.1:3306/mintreels
MYSQL_ROOT_PASSWORD=mintreels
MYSQL_USER=mintreels
MYSQL_PASSWORD=mintreels
MYSQL_DATABASE=mintreels

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Filestack (worker store/delete; APP_SECRET only if security policies are enabled)
FILESTACK_API_KEY=
FILESTACK_APP_SECRET=

# PyAI
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com
JOB_MAX_ATTEMPTS=4
JOB_RETRY_BASE_DELAY_MS=5000
JOB_STEP_STALE_TIMEOUT_MS=1800000

# Provider configuration
AI_PROVIDER=pyai
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
KNOWLEDGE_BASE_PROVIDER=pyai
STORAGE_PROVIDER=filestack
QUEUE_PROVIDER=bullmq

# Web (Vite)
VITE_API_TARGET=
# Auth (API only — never put JWT/SMTP secrets in frontend env)
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Local/dev only: skip email-verified check on login (true/1). Leave empty/false otherwise.
AUTH_SKIP_EMAIL_VERIFY=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
WEB_ORIGIN=http://127.0.0.1:5173
