NODE_ENV=development

# Nest API log verbosity: error | warn | log | debug | verbose (default log)
LOG_LEVEL=

# Database (MySQL 8)
DATABASE_URL=mysql://mintreels:mintreels@127.0.0.1:3306/mintreels
MYSQL_ROOT_PASSWORD=mintreels
MYSQL_USER=mintreels
MYSQL_PASSWORD=mintreels
MYSQL_DATABASE=mintreels

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Filestack (worker store/delete). APP_SECRET is required to delete files (Filestack remove).
FILESTACK_API_KEY=
FILESTACK_APP_SECRET=
# Browser upload only (Vite). Same key as FILESTACK_API_KEY is typical; never put APP_SECRET here.
VITE_FILESTACK_API_KEY=

# PyAI
# Speak (clip VO / overdub) needs voice:synthesize on the key in addition to Hear scopes.
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com
JOB_MAX_ATTEMPTS=4
JOB_RETRY_BASE_DELAY_MS=5000
JOB_STEP_STALE_TIMEOUT_MS=1800000

# Provider configuration
AI_PROVIDER=pyai
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
KNOWLEDGE_BASE_PROVIDER=pyai
STORAGE_PROVIDER=filestack
QUEUE_PROVIDER=bullmq

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hook_vectors
QDRANT_TRANSCRIPT_COLLECTION=transcript_windows
MOMENT_SEARCH_LIMIT=8
MOMENT_SEARCH_MIN_SIMILARITY=0.35
HOOK_SIMILARITY_THRESHOLD=0.85
HOOK_MAX_CANDIDATES=50
HOOK_FINAL_COUNT=10
CLIP_PREROLL_MS=3000
CLIP_POSTROLL_MS=5000
HOOK_WEIGHT_QUALITY=0.22
HOOK_WEIGHT_STANDALONE=0.15
HOOK_WEIGHT_CURIOSITY=0.12
HOOK_WEIGHT_EMOTIONAL=0.08
HOOK_WEIGHT_SPECIFICITY=0.08
HOOK_WEIGHT_SHAREABILITY=0.08
HOOK_WEIGHT_NOVELTY=0.04
HOOK_WEIGHT_CONTROVERSY=0.12
HOOK_WEIGHT_HEADLINE=0.11

# Web (Vite)
VITE_API_TARGET=
# Auth (API only — never put JWT/SMTP secrets in frontend env)
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Local/dev only: skip email-verified check on login (true/1). Leave empty/false otherwise.
AUTH_SKIP_EMAIL_VERIFY=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
WEB_ORIGIN=http://127.0.0.1:5173

# Guest / Anonymous Sandbox (API only). Set GUEST_ENABLED=false to turn off.
GUEST_ENABLED=true
GUEST_SESSION_TTL_SECONDS=86400
GUEST_DATA_RETENTION_SECONDS=259200
GUEST_MAX_PROJECTS=1
GUEST_MAX_RECORDINGS=3
GUEST_REQUESTS_PER_MINUTE=100
GUEST_UPLOADS_PER_HOUR=5
GUEST_TRANSCRIPTIONS_PER_HOUR=3
GUEST_AI_GENERATIONS_PER_HOUR=5
GUEST_SESSION_CREATIONS_PER_IP_PER_HOUR=10
