{
  "name": "mintreels",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "MintReels — open-source video intelligence and clipping application",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "setup": "tsx scripts/setup.ts",
    "db:seed": "node --import @swc-node/register/esm-register scripts/seed.ts",
    "seed": "pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mintreels/db": "workspace:*",
    "@mintreels/schema": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.2",
    "argon2": "^0.45.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "argon2",
      "esbuild",
      "msgpackr-extract"
    ],
    "ignoredOptionalDependencies": [
      "@huggingface/transformers"
    ]
  }
}
