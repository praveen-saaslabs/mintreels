  "dependencies": {
    "@mintreels/ai": "workspace:*",
    "@mintreels/db": "workspace:*",
    "@mintreels/domain": "workspace:*",
    "@mintreels/knowledge": "workspace:*",
    "@mintreels/media": "workspace:*",
    "@mintreels/queue": "workspace:*",
    "@mintreels/schema": "workspace:*",
    "@mintreels/storage": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
